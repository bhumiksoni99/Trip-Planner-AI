# Copy to .env and fill in. Never commit the filled-in file.

# --- Required ---

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://tavily.com  — web search for hotels, places and link previews
TAVILY_API_KEY=

# https://aviationstack.com  — live flight schedules (free tier: /v1/flights only)
AVIATIONSTACK_API_KEY=

# https://openweathermap.org/api  — used by the local weather MCP server
OPENWEATHER_API_KEY=

# Postgres connection string for the LangGraph checkpointer.
# The tables are created on first run, so an empty database is fine.
POSTGRES_DB=postgresql://user:password@host:5432/dbname

# Signs the login tokens. At least 32 characters; generate one with: openssl rand -base64 48
JWT_SECRET=

# --- Optional ---

# Fallback departure airport and city when the traveller doesn't name one
DEFAULT_ORIGIN=DEL
DEFAULT_ORIGIN_CITY=Delhi

# true brings back the approve / request-changes pause before the write-up
REQUIRE_APPROVAL=false

# How many revisions before the plan is written up anyway (only used with approval on)
MAX_REVISIONS=3

# DEBUG for per-agent detail
LOG_LEVEL=INFO

# Where the Next.js route handlers proxy to
BACKEND_URL=http://localhost:8000

# --- Optional: LangSmith tracing ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=itinera
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
